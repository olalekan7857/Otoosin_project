# O'Toosin Farms environment example
#
# Copy the values you need into the single local .env file at the project
# root. Never commit .env. This example file contains no real credentials.
# python-decouple loads <project>/.env; real process environment variables
# take precedence over values in that file.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=Otoosin_project.settings
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5555,http://127.0.0.1:5555
TIME_ZONE=Africa/Lagos
SITE_URL=http://localhost:8000

# Public base URL used for absolute links such as the staff order link.
# Format: http(s) origin only, with no path, query or fragment.
# Production: must be the public HTTPS origin, for example
# SITE_URL=https://otoosinfarms.example

# SQLite database path (absolute or relative to the project root).
SQLITE_PATH=db.sqlite3

# ---------------------------------------------------------------------------
# Static and media files
# ---------------------------------------------------------------------------
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media
WHITENOISE_MAX_AGE=31536000

# ---------------------------------------------------------------------------
# Security and cookies (safe development defaults shown)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
X_FRAME_OPTIONS=DENY
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=False
PASSWORD_RESET_TIMEOUT=86400

# ---------------------------------------------------------------------------
# Staff email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_FROM_EMAIL=
DEFAULT_FROM_EMAIL=
RESEND_TIMEOUT_SECONDS=30
STAFF_INVITATION_HOURS=72
SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Paystack (server-side only; never expose the secret key to templates)
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE=
DJANGO_LOG_MAX_BYTES=5242880
DJANGO_LOG_BACKUP_COUNT=5
