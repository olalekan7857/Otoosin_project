# O'Toosin Farms environment example
#
# Copy the values you need into the single local .env file at the project
# root. Never commit .env. This example file contains no real credentials.
# python-decouple loads <project>/.env; real process environment variables
# take precedence over values in that file.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=Otoosin_project.settings
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5555,http://127.0.0.1:5555
TIME_ZONE=Africa/Lagos
SITE_URL=http://localhost:8000

# Public base URL used for absolute links such as the staff order link.
# Format: http(s) origin only, with no path, query or fragment.
# Production: must be the public HTTPS origin, for example
# SITE_URL=https://otoosinfarms.example

# SQLite database path (absolute or relative to the project root).
SQLITE_PATH=db.sqlite3

# ---------------------------------------------------------------------------
# Static and media files
# ---------------------------------------------------------------------------
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media
WHITENOISE_MAX_AGE=31536000

# ---------------------------------------------------------------------------
# Security and cookies (safe development defaults shown)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
X_FRAME_OPTIONS=DENY
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=False
PASSWORD_RESET_TIMEOUT=86400

# ---------------------------------------------------------------------------
# Staff email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_FROM_EMAIL=
DEFAULT_FROM_EMAIL=
RESEND_TIMEOUT_SECONDS=30
STAFF_INVITATION_HOURS=72
SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Paystack (server-side only; never expose the secret key to templates)
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# WhatsApp Cloud API staff notification
# ---------------------------------------------------------------------------
# Safe default: disabled. Set to True only after every value below is correct.
WHATSAPP_ENABLED=False
# Preserved legacy WhatsApp order hook. Email order notifications are the
# active channel and do not depend on this value. Leave False.
WHATSAPP_ORDER_NOTIFICATIONS_ENABLED=False
WHATSAPP_ACCESS_TOKEN=
# Meta phone number ID (numeric), not the visible phone number.
WHATSAPP_PHONE_NUMBER_ID=
# Optional Meta identifiers kept server-side for reference.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
# Graph API version with a single "v" prefix, for example v25.0.
WHATSAPP_GRAPH_API_VERSION=v25.0
# Comma-separated admin recipient numbers. Local Nigerian numbers such as
# 08031234567 are normalized to 2348031234567; international numbers may use
# +2348031234567. Do not use punctuation such as dashes or parentheses.
WHATSAPP_ADMIN_RECIPIENTS=
# EXACT approved Meta template name. This is NOT a sample template name and
# must match the template under the configured WhatsApp Business Account.
WHATSAPP_MESSAGE_TEMPLATE=
# Meta template language code, for example en_US.
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Comma-separated order field keys in the EXACT positional order of the
# template body placeholders {{1}}, {{2}}, {{3}} ... The list length must
# match the number of body placeholders; do not add unused fields.
# Supported keys:
#   alert_title, order_reference, order_datetime, order_status,
#   customer_name, customer_phone, customer_email, customer_notes,
#   items, subtotal, delivery_fee, total, currency,
#   payment_status, payment_method, fulfilment, fulfilment_location,
#   delivery_address, delivery_instructions, admin_url
# Recommended full mapping (20 body placeholders):
WHATSAPP_TEMPLATE_BODY_FIELDS=alert_title,order_reference,order_datetime,order_status,customer_name,customer_phone,customer_email,customer_notes,items,subtotal,delivery_fee,total,currency,payment_status,payment_method,fulfilment,fulfilment_location,delivery_address,delivery_instructions,admin_url
# Optional comma-separated ORDER FIELD keys for a text HEADER component with
# placeholders. Leave blank when the template header has no variables.
WHATSAPP_TEMPLATE_HEADER_FIELDS=
# Optional dynamic URL button. Leave blank when the template has no dynamic
# URL button. The named field's value is sent as the button URL suffix, e.g.
# order_reference for a template URL such as
# https://otoosinfarms.example/staff/orders/{{1}}
WHATSAPP_TEMPLATE_URL_BUTTON_FIELD=
# Zero-based index of the URL button component in the Meta template.
WHATSAPP_TEMPLATE_URL_BUTTON_INDEX=0
# Positive integer request timeout in seconds.
WHATSAPP_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE=
DJANGO_LOG_MAX_BYTES=5242880
DJANGO_LOG_BACKUP_COUNT=5
